# Vercel server-side environment variables. Never commit real credentials.
TEACHER_PASSWORD=replace-with-a-private-password-at-least-12-characters
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
FIREBASE_SERVICE_ACCOUNT={"project_id":"YOUR_PROJECT_ID","client_email":"YOUR_SERVICE_ACCOUNT_EMAIL","private_key":"YOUR_PRIVATE_KEY"}
FIREBASE_WEB_CONFIG={"apiKey":"YOUR_WEB_API_KEY","authDomain":"YOUR_PROJECT_ID.firebaseapp.com","projectId":"YOUR_PROJECT_ID","appId":"YOUR_WEB_APP_ID"}
